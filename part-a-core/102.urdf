<?xml version="1.0"?>

<!-- Name of the Robot -->
<robot name="myfirst">

    <!-- Name of the Link -->
    <link name="base_link">

        <visual>
            <geometry>
                <!-- Dimensions of the cylinder -->
                <cylinder length="0.6" radius="0.25"/>
            </geometry>
        </visual>
    <!-- Adding Collission Tag -->
        <collision>
            <geometry>
                <!-- Dimensions of the cylinder -->
                <cylinder length="0.6" radius="0.25"/>
            </geometry>
           </collision>
    <!-- Adding Intertial Tag so physic engine can calculate the physical behavioir also-->
        <inertial>
         <!-- Weight of Cylinder -->
            <mass value="0.25"/>
           <!-- The center of mass is located at the link origin (0,0,0). -->
            <origin xyz="0 0 0"/>
            <mass value="1"/>
 <!-- Adding the movement around each axix -->
            <inertia
                ixx="0.1"
                ixy="0"
                ixz="0"
                iyy="0.1"
                iyz="0"
                izz="0.1"/>
        </inertial>
    </link>
<!-- Adding Second Link -->
<link name="sub_link">

        <visual>
            <geometry>
                <!-- Dimensions of the cylinder -->
                <cylinder length="1" radius="0.1"/>
            </geometry>
        </visual>
    <!-- Adding Collission Tag -->
        <collision>
            <geometry>
                <!-- Dimensions of the cylinder -->
                <cylinder length="1" radius="0.1"/>
            </geometry>
           </collision>
    <!-- Adding Intertial Tag so physic engine can calculate the physical behavioir also-->
        <inertial>
         <!-- Weight of Cylinder -->
            <mass value="0.25"/>
           <!-- The center of mass is located at the link origin (0,0,0). -->
            <origin xyz="0 0 0"/>
            <mass value="1"/>
 <!-- Adding the movement around each axix -->
            <inertia
                ixx="0.1"
                ixy="0"
                ixz="0"
                iyy="0.1"
                iyz="0"
                izz="0.1"/>
        </inertial>

    </link>


<!-- Adding Second Link -->
<link name="sub_link2">

        <visual>
            <geometry>
                <!-- Dimensions of the cylinder -->
                <cylinder length="5" radius="0.1"/>
            </geometry>
        </visual>
    <!-- Adding Collission Tag -->
        <collision>
            <geometry>
                <!-- Dimensions of the cylinder -->
                <cylinder length="5" radius="0.1"/>
            </geometry>
           </collision>
    <!-- Adding Intertial Tag so physic engine can calculate the physical behavioir also-->
        <inertial>
         <!-- Weight of Cylinder -->
            <mass value="0.25"/>
           <!-- The center of mass is located at the link origin (0,0,0). -->
            <origin xyz="0 0 0"/>
            <mass value="1"/>
 <!-- Adding the movement around each axix -->
            <inertia
                ixx="0.1"
                ixy="0"
                ixz="0"
                iyy="0.1"
                iyz="0"
                izz="0.1"/>
        </inertial>

    </link>


        <!-- First Joint,  Type = Revolute to allow rotation -->
    <joint name="base_to_sub" type="revolute">
        <parent link="base_link"/>
        <!-- Child Link to connect -->
        <child link="sub_link"/>
        <axis xyz="1 0 0"/>
                <!-- Behavior of the joint: How Motor work in the joint -->
                <!-- Effort is how much power can be applied on robot via motor  -->
                <!-- lower and upper is the minimum and maximum effort that can be applied  -->
                <!-- Effort is how much power can be applied on robot via motor: Different Speed  -->
                <!-- Velocity is the maximum speed at which the joint can move -->

        <limit effort="10" upper="0" lower="10" velocity="1"/>
                <!-- Rotation angle of the joint -->

        <origin rpy="0 0 0" xyz="0.5 0 0"/>
        
    </joint>


    
    <!-- Adding Second Joint -->
    <joint name="base_to_sub_link2" type="revolute">
        <parent link="base_link"/>
        <!-- Child Link to connect -->
        <child link="sub_link2"/>
        <axis xyz="1 0 0"/>
                <!-- Behavior of the joint: How Motor work in the joint -->
                <!-- Effort is how much power can be applied on robot via motor  -->
                <!-- lower and upper is the minimum and maximum effort that can be applied  -->
                <!-- Effort is how much power can be applied on robot via motor: Different Speed  -->
                <!-- Velocity is the maximum speed at which the joint can move -->

        <limit effort="10" upper="0" lower="10" velocity="1"/>
                <!-- Rotation angle of the joint -->

        <origin rpy="0 0 0" xyz="0.5 0 0"/>
        
    </joint>



</robot>